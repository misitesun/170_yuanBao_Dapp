# Runtime endpoints and shared project values.
# 运行时接口地址和项目通用值。

# App display information.
# 应用展示信息。

# Browser title and mobile web app title.
# 浏览器标题和移动端 Web App 标题。
VITE_APP_NAME =

# API request base URL; empty value means using the current site origin.
# 接口请求基础地址；为空时表示使用当前站点域名。
VITE_BASE_URL =

# RPC endpoint of the local DApp test chain; blank uses http://127.0.0.1:8545.
# 本地 DApp 测试链的 RPC 节点地址；为空时使用 http://127.0.0.1:8545。
VITE_RPC_URL =

# USDT contract address or asset identifier used by the current chain.
# 当前链上使用的 USDT 合约地址或资产标识。
VITE_USDT =

# Social sharing metadata for link previews.
# 链接预览使用的社交分享元信息。

# Whether to inject social sharing meta tags into index.html.
# 是否向 index.html 注入社交分享 meta 标签。
VITE_ENABLE_SOCIAL_META = 0

# Page title shown in Telegram, X, Discord, Facebook and similar platforms.
# Telegram、X、Discord、Facebook 等平台展示的页面标题。
VITE_SOCIAL_TITLE =

# Page description shown in social link previews and the HTML description meta.
# 社交链接预览和 HTML description meta 展示的页面描述。
VITE_SOCIAL_DESCRIPTION =

# Canonical page URL used by social platforms; use a public absolute URL.
# 社交平台识别的页面标准地址；使用公网可访问的绝对地址。
VITE_SOCIAL_URL =

# Share preview image URL; use a public absolute URL, recommended size 1200x630.
# 分享预览图片地址；使用公网可访问的绝对地址，推荐尺寸 1200x630。
VITE_SOCIAL_IMAGE =

# Share preview image width in pixels.
# 分享预览图片宽度，单位为 px。
VITE_SOCIAL_IMAGE_WIDTH =

# Share preview image height in pixels.
# 分享预览图片高度，单位为 px。
VITE_SOCIAL_IMAGE_HEIGHT =

# Alternative text for the share preview image.
# 分享预览图片的替代文本。
VITE_SOCIAL_IMAGE_ALT =

# Open Graph locale code, for example en_US or zh_CN.
# Open Graph 使用的语言地区代码，例如 en_US 或 zh_CN。
VITE_SOCIAL_LOCALE =

# X/Twitter account that owns the site, for example @project_name.
# X/Twitter 站点所属账号，例如 @project_name。
VITE_SOCIAL_X_SITE =

# X/Twitter account that created the content, for example @project_name.
# X/Twitter 内容作者账号，例如 @project_name。
VITE_SOCIAL_X_CREATOR =
